# Application
APP_ENV=development
LOG_LEVEL=info
API_PORT=8080
WEB_PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# PostgreSQL (Docker Compose default)
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
DB_DRIVER=postgres
DATABASE_URL=postgres://app:app@postgres:5432/app?sslmode=disable
AUTO_MIGRATE=true
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m

# MySQL alternative:
# DB_DRIVER=mysql
# DATABASE_URL=app:app@tcp(mysql:3306)/app?parseTime=true&charset=utf8mb4

# Redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# Authentication — replace before any public deployment.
JWT_SECRET=replace-this-development-secret-before-production
JWT_ISSUER=go-vue-starter
JWT_TTL=24h

# Frontend
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://api:8080
