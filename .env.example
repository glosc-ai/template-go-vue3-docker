# Application
APP_ENV=development
LOG_LEVEL=info
API_PORT=8080
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# PostgreSQL (Docker Compose default)
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
DB_DRIVER=postgres
DATABASE_URL=postgres://app:app@postgres:5432/app?sslmode=disable
AUTO_MIGRATE=true
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m

# MySQL alternative:
# DB_DRIVER=mysql
# DATABASE_URL=app:app@tcp(mysql:3306)/app?parseTime=true&charset=utf8mb4

# Redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# Authentication — replace before any public deployment.
JWT_SECRET=replace-this-development-secret-before-production
JWT_ISSUER=go-vue-starter
JWT_TTL=24h

# Single sign-on (Glosc AI SSO, OAuth 2.0 授权码 + PKCE)
# 在 https://sso.gloscai.com/dashboard/clients 创建客户端后填写。
# 留空 SSO_CLIENT_ID 即关闭登录功能，模板其余部分照常运行。
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
# 必须与客户端白名单逐字一致（协议、域名、端口、路径）。
# 开发：浏览器访问 5173，由 Vite 代理到 API，因此这里填 5173。
SSO_REDIRECT_URL=http://localhost:5173/api/v1/auth/sso/callback
SSO_ISSUER=https://sso.gloscai.com
# 默认由 SSO_ISSUER 推导，一般无需设置。
# SSO_DISCOVERY_URL=https://sso.gloscai.com/api/.well-known/openid-configuration
SSO_SCOPES=user:read
SSO_POST_LOGIN_PATH=/profile
# 仅在 HTTPS 下开启；生产环境默认为 true。
SESSION_COOKIE_SECURE=false

# Frontend
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://api:8080
